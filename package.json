{
  "name": "daystate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "npm run build && wrangler pages dev dist",
    "build:web": "tsc -b && vite build",
    "typecheck:functions": "tsc -p functions/tsconfig.json",
    "build:functions:bundle": "wrangler pages functions build functions --outdir .wrangler/functions-build --minify",
    "build:functions": "npm run build:functions:bundle && node scripts/copy-worker.mjs",
    "build": "npm run build:web && npm run typecheck:functions && npm run build:functions",
    "db:migrate:local": "wrangler d1 migrations apply daystate-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply daystate-db --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name daystate --branch production",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.123.0"
  }
}
